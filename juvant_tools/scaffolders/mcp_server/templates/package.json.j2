{
  "name": "{{ package_name }}",
  "version": "0.0.1",
  "description": "{{ vendor_description }}",
  "license": "MIT",
  "author": "Juvant Srls",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "{{ repo_name }}": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --pretty false",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juvantlabs/{{ repo_name }}.git"
  },
  "homepage": "https://github.com/juvantlabs/{{ repo_name }}#readme",
  "bugs": {
    "url": "https://github.com/juvantlabs/{{ repo_name }}/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "{{ vendor }}",
    "juvant-os"
  ]
}
